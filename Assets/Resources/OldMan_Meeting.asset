  - NodeGUID: 081e7171-f274-4a02-a693-ad3e6cd9360a
    DialogueText: "Selam evlat. Senin ad\u0131n Arthur'du, yan\u0131lm\u0131yorum
      de\u011Fil mi?"
    Position: {x: 727, y: 215}
    Choices: []
    ReputationChanges: 
    EntryPoint: 0
    IsEndNode: 0
    IsPlayerNode: 0
    CloseDialogAfterThis: 0
  - NodeGUID: 85804190-113f-4e07-8f40-4dd642c41a98
    DialogueText: 
    Position: {x: 1103, y: 215}
    Choices:
    - "Ad\u0131m\u0131 nereden biliyorsun?"
    - "Ad\u0131m\u0131 s\xF6yledi\u011Fine g\xF6re beni tan\u0131yorsun."
    ReputationChanges: 0000000000000000
    EntryPoint: 0
    IsEndNode: 0
    IsPlayerNode: 1
    CloseDialogAfterThis: 0
  - NodeGUID: baa6fcfb-234b-405e-a415-eeb501441a32
    DialogueText: 
    Position: {x: 1936, y: 280}
    Choices:
    - " Buras\u0131 neden bu halde?"
    - "buradan nas\u0131 kurtulabilirim?"
